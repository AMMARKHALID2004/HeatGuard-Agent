# HeatGuard Agent — backend environment
# Copy to backend/.env and fill in. NEVER commit .env, and never expose any of
# these values to the frontend (see CLAUDE.md → Known issues #5).

# --- Required ---

# FortyGuard Temperature API key. Sent as the `api-key` request header.
FORTYGUARD_API_KEY=

# Groq API key (free tier). OpenAI-compatible endpoint used for agent reasoning.
GROQ_API_KEY=

# --- Optional ---

# Slack Incoming Webhook. When set, a RESCHEDULE decision posts an alert here.
# Leave blank to disable Slack alerting entirely (the API still returns the decision).
SLACK_WEBHOOK_URL=

# --- Optional overrides (defaults in app/config.py are fine for the demo) ---

# FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# Bounded polling of the FortyGuard async job (CLAUDE.md → Known issues #3).
# 15 attempts with 2s initial delay and 1.5x backoff capped at 15s ≈ 2.7 min of waiting.
# POLL_MAX_ATTEMPTS=15
# POLL_INITIAL_DELAY_SECONDS=2.0
# POLL_BACKOFF_FACTOR=1.5
# POLL_MAX_DELAY_SECONDS=15.0
# HTTP_TIMEOUT_SECONDS=30.0

# Comma-separated origins allowed to call this API (the Next.js dashboard).
# CORS_ALLOW_ORIGINS=http://localhost:3000
