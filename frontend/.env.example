# HeatGuard Agent — frontend environment
# Copy to frontend/.env.local and adjust.
#
# Only NEXT_PUBLIC_* values belong here, and they are visible in the browser.
# FORTYGUARD_API_KEY / GROQ_API_KEY / SLACK_WEBHOOK_URL must NEVER appear in this file —
# they live in backend/.env only (CLAUDE.md → Known issues #5).

# Base URL of the FastAPI backend. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Offline UI work -----------------------------------------------------------------
# Answer from lib/mock.ts instead of calling the backend. No network, no API credits, and
# every state (including the 504/503/500 failures and the no-readings fail-safe) reachable
# from the picker in the mock banner.
#
# Leave this UNSET in any deployed environment. Mock decisions are realistic on purpose, so
# the only thing distinguishing them from a measurement is the banner and the `mock-` job id.
# USE_MOCK_DATA=1
#
# Set it HERE rather than on the command line. `USE_MOCK_DATA=1 next dev` works, but Next
# re-derives the client env whenever this file is saved ("Reload env: .env.local" in the dev
# server log) and a shell-provided value is dropped at that point — mock mode then switches
# itself off mid-session, leaving a dashboard that looks live but reaches nothing. Verified
# by hitting exactly that. `NEXT_PUBLIC_USE_MOCK_DATA=1` also works and survives the reload.
