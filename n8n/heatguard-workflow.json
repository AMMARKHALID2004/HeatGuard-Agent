    {
      "parameters": {
        "jsCode": "const raw = $json.output;\n\nlet result;\n\ntry {\n  result = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"Agent did not return valid JSON: \" + raw);\n}\n\nreturn [{\n  json: {\n    risk_level: result.risk_level,\n    peak_temperature: result.peak_temperature,\n    average_temperature: result.average_temperature,\n    decision: result.decision,\n    recommendation: result.recommendation,\n    reason: result.reason,\n    source: \"FortyGuard Temperature API\",\n    agent: \"HeatGuard Agent\"\n  }\n}];"
